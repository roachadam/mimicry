{
  "name": "mimicry-http",
  "version": "0.0.0",
  "description": "Browser-identical HTTP from Node: mimicry's client through its core binary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roachadam/mimicry.git",
    "directory": "bindings/node"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/gen', 'dist/gen', { recursive: true })\"",
    "check": "tsc -p tsconfig.json && eslint . && node scripts/gen.ts --check",
    "gen": "node scripts/gen.ts",
    "gen:check": "node scripts/gen.ts --check",
    "test": "node --test --test-timeout=300000 'test/**/*.test.ts'",
    "pack:all": "node scripts/pack.ts",
    "pretest": "node scripts/build-core.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
