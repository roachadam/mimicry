.DS_Store
.claude/*
.cursor
.worktrees
.env

# moon
.moon/cache/

# Build output. `go build` names the binary after the command and writes it
# where it runs: in the cmd's own directory, or in the module root for
# `go build ./cmd/<name>`. A new command adds its name here.
bin/
*.exe
*.test
**/cmd/*/*
!**/cmd/*/*.*
!**/cmd/*/*/
/mimicry-core
/pins
/profilegen
/internal/harness/capture
/internal/harness/clientcapture
/internal/harness/diff
/internal/harness/h3gen
/internal/harness/hellogen
/internal/harness/interop
/internal/harness/kindsgen
/internal/harness/pageshape
/internal/harness/realcheck
/internal/harness/refresh
/internal/harness/releasewatch
/internal/harness/tracestat
/internal/bench/bench
/internal/bench/proxy
/internal/bench/server
/internal/bench/setup

# Profiler output from the bench README's profiling recipe
/internal/bench/reports/**/*.pprof

# TLS key logs, qlogs, packet captures and Chrome net-logs: they hold
# session secrets or real traffic
*.keylog
keys.log
*.qlog
*.sqlog
*.pcap
*.pcapng
*netlog*.json
# cmd/realcheck's output
mimicry-realcheck/

# cmd/refresh's staging: builds, captures before they are installed, logs
.refresh/

# Local-only workspace for trying unmerged changes in ../utls (see AGENTS.md)
go.work
go.work.sum

# The Python SDK (bindings/python): the core built into the package, the
# development environment, build output and tool caches
/bindings/python/src/mimicry/_bin/
/bindings/python/.venv/
/bindings/python/dist/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
