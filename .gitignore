.DS_Store
.claude/*
.cursor
.worktrees
.env

# moon
.moon/cache/

# Build output: `go build` in a cmd directory writes a binary named after it
bin/
**/cmd/*/*
!**/cmd/*/*.*
!**/cmd/*/*/
*.test

# Profiler output from the bench README's profiling recipe
/internal/bench/reports/**/*.pprof

# TLS key logs, qlogs, packet captures and Chrome net-logs: they hold
# session secrets or real traffic
*.keylog
keys.log
*.qlog
*.sqlog
*.pcap
*.pcapng
*netlog*.json
# cmd/realcheck's output
mimicry-realcheck/

# cmd/refresh's staging: builds, captures before they are installed, logs
.refresh/

# Local-only workspace for trying unmerged changes in ../utls (see AGENTS.md)
go.work
go.work.sum
